// After: enriched .dot — every node links to code
digraph after {
    rankdir=LR
    fontname="Helvetica"
    node [fontname="Helvetica" fontsize=10 style=filled]
    edge [fontname="Helvetica" fontsize=9]
    label="After: Live Architecture Map"
    labelloc=t fontsize=12
    bgcolor="#1e1e1e"
    node [fontcolor=white]
    edge [color="#888888" fontcolor="#cccccc"]

    order [label="Order\n\norder.py:196\ntransfer_proposal_to_order:219" shape=box fillcolor="#264f78" URL="vscode://file/order.py:196" tooltip="Sales order — customer commitment"]
    invoice [label="Invoice\n\norder_to_invoice.py:16\nPending.create:332" shape=box fillcolor="#264f78" URL="vscode://file/invoice.py" tooltip="Invoice — shipment event"]
    pending [label="Pending\n\npending.py:6\n6 creation sites" shape=box fillcolor="#78264f" URL="vscode://file/pending.py:6" tooltip="Central hub for inventory deltas"]
    item [label="Item\n\nitem.py:196\nquantity JSONField:238" shape=box fillcolor="#264f78" URL="vscode://file/item.py:196" tooltip="Product with quantity buckets"]

    order -> invoice [label="transfer" color="#4ec9b0"]
    invoice -> pending [label="-on_hand\n-on_so\n+on_in" color="#f48771"]
    pending -> item [label="update qty" color="#4ec9b0"]
}
