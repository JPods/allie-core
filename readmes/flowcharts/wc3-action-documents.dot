// WC3 Action Documents — uploading images, videos, and files to Action records
// Shows the attachment pipeline: upload → Document → LinkageEntry → Action
// Render: dot -Tpdf wc3-action-documents.dot -o wc3-action-documents.pdf

// CodeMap revision: 1 — 2026-08-11

digraph wc3_action_documents {
    rankdir=TB
    fontname="Helvetica"
    fontsize=11
    node [fontname="Helvetica" fontsize=10 style=filled]
    edge [fontname="Helvetica" fontsize=8]
    label="WC3 — Action Documents\nUpload images, videos, and files to Action records"
    labelloc=t
    fontsize=14
    pad=0.5
    nodesep=0.7

    // Upload entry
    upload [label="File Upload\n\nimage/png\nimage/jpeg\nvideo/mp4\napplication/pdf\nany mime_type" shape=box fillcolor="#85C1E9" fontsize=9]

    // Processing
    checksum [label="SHA256\nChecksum\n\ndedup check" shape=box fillcolor="#D5D8DC" fontsize=9]
    inline_encode [label="Inline Encoding\n\nzlib + base64\nstored in config" shape=box fillcolor="#D5D8DC" fontsize=9]
    exif_extract [label="EXIF Extraction\n\ncamera, datetime\nwidth, height\ngps coordinates" shape=box fillcolor="#D5D8DC" fontsize=9]
    virus_scan [label="Virus Scan\n\nscanner, status\nthreat, quarantined" shape=box fillcolor="#FADBD8" fontsize=9]

    // Document record
    document [label="Document\n\nname\nmime_type\nsize_bytes\nchecksum\npath.storage\npath.key\nconfig.inline_content_b64\nmetadata.exif\nmetadata.virus" shape=box fillcolor="#8E44AD" fontcolor=white fontsize=9]

    // LinkageEntry
    linkage_parent [label="LinkageEntry\n(parent)\n\nmodel_name='action'\nrecord_id=action.id\npurpose='attachment'\nrole='parent'" shape=box fillcolor="#82E0AA" fontsize=9]
    linkage_child [label="LinkageEntry\n(child)\n\nmodel_name='document'\nrecord_id=doc.id\npurpose='attachment'\nrole='child'" shape=box fillcolor="#82E0AA" fontsize=9]

    // Action
    action [label="Action\n\n_pending_attachments[]\npre_save captures\npost_save creates linkage" shape=diamond fillcolor="#F4D03F" fontsize=9]

    // Multiple documents
    doc2 [label="Document 2\n(another file)" shape=box fillcolor="#8E44AD" fontcolor=white fontsize=9]
    linkage_child2 [label="LinkageEntry\n(child 2)" shape=box fillcolor="#82E0AA" fontsize=9]

    // Access
    access [label="Access & Display\n\ncount_accessed++\nmetadata.history.accessed\nretention_period" shape=box fillcolor="#F5B7B1" fontsize=9]

    // Group
    group_id [label="group_id\n\nclusters all entries\nfor one attachment set\nnext_group_id()" shape=note fillcolor="#FDFEFE" fontsize=8]

    // Flow
    upload -> checksum [label="compute hash"]
    upload -> inline_encode [label="small files"]
    upload -> exif_extract [label="images" style=dashed]
    upload -> virus_scan [label="all files" style=dashed]

    checksum -> document [label="create record"]
    inline_encode -> document [label="config.inline_*"]
    exif_extract -> document [label="metadata.exif" style=dashed]
    virus_scan -> document [label="metadata.virus" style=dashed]

    action -> linkage_parent [label="post_save hook" color="#27AE60"]
    document -> linkage_child [label="for each doc" color="#27AE60"]
    doc2 -> linkage_child2 [label="additional" color="#27AE60" style=dashed]

    group_id -> linkage_parent [style=dashed color="#888"]
    group_id -> linkage_child [style=dashed color="#888"]
    group_id -> linkage_child2 [style=dashed color="#888"]

    document -> access [label="on view" style=dashed]
}
