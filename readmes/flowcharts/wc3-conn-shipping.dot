// WC3 Shipping Carrier Flow — order to delivery tracking
// Render: dot -Tpdf wc3-conn-shipping.dot -o wc3-conn-shipping.pdf

// CodeMap revision: 1 — 2026-08-11

digraph wc3_conn_shipping {
    rankdir=TB
    fontname="Helvetica"
    fontsize=11
    node [fontname="Helvetica" fontsize=10 style=filled]
    edge [fontname="Helvetica" fontsize=8]
    label="WC3 — Shipping Carrier Flow"
    labelloc=t
    fontsize=14
    pad=0.5

    // Order source
    order [label="Order\n(Order model)" shape=box fillcolor="#D4E6F1"]

    // Package details
    package [label="Package Details\n\nweight\ndimensions\nship-to address\nservice level" shape=box fillcolor="#FCF3CF"]

    // Carrier API cluster
    subgraph cluster_carriers {
        label="Carrier APIs"
        style=filled fillcolor="#F5EEF8" color="#D7BDE2"
        fontsize=8
        ups [label="UPS" shape=box fillcolor="#E8DAEF" fontsize=8]
        fedex [label="FedEx" shape=box fillcolor="#E8DAEF" fontsize=8]
        usps [label="USPS" shape=box fillcolor="#E8DAEF" fontsize=8]
        dhl [label="DHL" shape=box fillcolor="#E8DAEF" fontsize=8]
    }

    // Rate selection
    rates [label="Rate Comparison\n\ncost\ntransit time\nservice level" shape=octagon fillcolor="#F5CBA7"]

    // Rate decision
    select [label="Best\nRate?" shape=diamond fillcolor="#FADBD8"]

    // Label
    label_gen [label="Label Generation\n\ntracking number\nbarcode\nreturn label" shape=box fillcolor="#FCF3CF"]

    // Tracking events
    tracking [label="Tracking Events\n(webhook)\n\npickup\nin-transit\nout-for-delivery\ndelivered\nexception" shape=box fillcolor="#F5CBA7"]

    // Order status update
    status [label="Order Status\nUpdate\n\nshipped\nin-transit\ndelivered" shape=box fillcolor="#ABEBC6"]

    // Invoice
    invoice [label="Invoice\n(shipping cost\nline item)" shape=box fillcolor="#ABEBC6"]

    // Alice
    alice [label="Alice\nCarrier Performance\nMonitoring\n\non-time %\nexception rate\ncost trends" shape=box fillcolor="#AED6F1"]

    // Edges
    order -> package [label="pick/pack"]
    package -> ups
    package -> fedex
    package -> usps
    package -> dhl
    ups -> rates
    fedex -> rates
    usps -> rates
    dhl -> rates
    rates -> select
    select -> label_gen [label="selected\ncarrier"]
    label_gen -> tracking [label="tracking\nnumber"]
    tracking -> status [label="event\nupdates"]
    status -> order [label="update\norder" style=dashed]
    label_gen -> invoice [label="shipping\ncost"]
    tracking -> alice [label="performance\ndata" style=dashed]
    alice -> rates [label="recommend\ncarrier" style=dashed]
}
