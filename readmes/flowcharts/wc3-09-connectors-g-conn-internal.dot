// WC3 Connection: Internal Agent Communication — Alice, Claude Code, WC_HQ coordination
// Render: dot -Tpdf wc3-conn-internal.dot -o wc3-conn-internal.pdf

// CodeMap revision: 1 — 2026-08-11

digraph wc3_conn_internal {
    size="7.5,10.0"
    ratio="compress"


    rankdir=TB
    fontname="Helvetica"
    fontsize=11
    node [fontname="Helvetica" fontsize=10 style=filled]
    edge [fontname="Helvetica" fontsize=8]
    label="WC3 Connection — Internal Agent Communication"
    labelloc=t
    fontsize=14
    pad=0.5

    // ── Alice ──
    alice [label="Alice\n(AI Agent)\n\nPattern recognition\nTransaction monitoring\nHousekeeping" shape=box fillcolor="#AED6F1"]

    // ── Action record ──
    action [label="Action Record\n(Action model)\n\nconfig.escalation\nowner / sunset\nstatus tracking" shape=box fillcolor="#FCF3CF"]

    // ── Claude Code ──
    claude [label="Claude Code\n\nPickup at leftshoe\nProcess actions\nWrite code / fixes" shape=box fillcolor="#D4E6F1"]

    // ── leftshoe ──
    leftshoe [label="leftshoe\n(MCP tool)\n\nSession opening\nTeam status\nAction queue" shape=octagon fillcolor="#F5CBA7"]

    // ── WC3 Instance ──
    wc3_instance [label="WC3 Instance\n(retailer/org)\n\nLocal database\nLocal commerce" shape=box fillcolor="#FCF3CF"]

    // ── Bundle ──
    bundle [label="Bundle\n\nTemplate sync\nSchema feedback\nLayout submissions\nAudit trail" shape=box fillcolor="#F5CBA7"]

    // ── Alice review ──
    alice_review [label="Alice Reviews\n\nValidate bundle\nCheck schema drift\nFlag anomalies" shape=octagon fillcolor="#AED6F1"]

    // ── WC_HQ ──
    wc_hq [label="WC_HQ\n(headquarters)\n\nReviews submissions\nDistributes updates\nMaintains standards" shape=box fillcolor="#D4E6F1"]

    // ── Distribution ──
    distribute [label="Distribute\n\nApproved templates\nSchema updates\nPolicy changes" shape=octagon fillcolor="#F5CBA7"]

    // ── Internal tools ──
    internal_tools [label="Internal Tools\n\nStatement Sorter\ndatabrowser\nConversion pipeline" shape=box fillcolor="#D5F5E3"]

    // ── Edges: Alice -> Claude Code path ──
    alice -> action [label="creates\nescalation"]
    action -> leftshoe [label="queued for\npickup"]
    leftshoe -> claude [label="session\nopening"]
    claude -> action [style=dashed label="resolves\nupdates status"]

    // ── Edges: WC3 Instance -> WC_HQ path ──
    wc3_instance -> bundle [label="submit\nfeedback"]
    bundle -> alice_review [label="validate"]
    alice_review -> wc_hq [label="approved\nbundles"]
    wc_hq -> distribute [label="review\napprove"]
    distribute -> wc3_instance [label="updates\ntemplates" style=dashed]

    // ── Edges: internal tools ──
    internal_tools -> wc3_instance [label="self-service\ntools" dir=both]

    // ── Alice monitoring ──
    alice -> wc3_instance [style=dashed label="monitor\npatterns"]
    alice -> alice_review [style=dashed label="schema\ndrift check"]
}
