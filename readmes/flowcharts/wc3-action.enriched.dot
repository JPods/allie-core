// WC3 Action — Universal task/workflow/support model
// References any record via tableName+idNum; multiple display modes
// Render: dot -Tpdf wc3-action.dot -o wc3-action.pdf

// CodeMap revision: 1 — 2026-08-11

digraph wc3_action {
    size="10.0,7.5"
    ratio="compress"



    // ── CodeMap Standard Style ──
    fontname="Helvetica Neue,Helvetica,Arial,sans-serif"
    fontsize=12
    bgcolor="white"
    pad=0.4
    nodesep=0.5
    ranksep=0.6
    splines=true

    node [
        fontname="Helvetica Neue,Helvetica,Arial,sans-serif"
        fontsize=10
        style="filled,rounded"
        shape=box
        penwidth=1.2
        color="#555555"
    ]

    edge [
        fontname="Helvetica Neue,Helvetica,Arial,sans-serif"
        fontsize=10
        penwidth=2.0
        arrowhead=normal
        arrowsize=1.4
        color="#666666"
        fontcolor="#444444"
    ]

    rankdir=TB
    label="WC3 — Action Model\nUniversal task: Who, What, Why, When, Where, How"
    labelloc=t

    // Action
    action [label="Action\n(ActionEntity)\n\nWho\nWhat\nWhy\nWhen\nWhere\nHow\nCommunications\nLogistics" shape=diamond fillcolor="#F4D03F" fontsize=10 URL="vscode://file/Users/williamjames/Documents/CommerceExpert/webClerk3/apps/core/models/action.py:10" target="_blank" tooltip="Universal task — who, what, why, when, where, how. References any record. Tracks communication touches.\nModel: apps/core/models/action.py:10\nFunctions:
  Action._pending_attachments @ apps/core/models/action.py:198 (pre_save captures attachment list)
  Action.post_save (linkage) @ apps/core/models/action.py:230 (creates LinkageEntry group for documents)
  Action.contact_id resolve @ apps/core/models/action.py:285 (auto-resolves contact from assigned_to)"]

    // Reference
    action_ref [label="Action.reference\n\ntableName\nidNum\nreason\netc..." shape=note fillcolor="#FDFEFE" fontsize=9]

    // Any record
    any_record [label="Any or multiple\ntablenames/collections\nrecord/document" shape=box fillcolor="#E59866" fontcolor=white]

    // Record types
    customer [label="Customer" shape=box fillcolor="#F4D03F"]
    vendor [label="Vendor" shape=box fillcolor="#E59866"]
    proposals [label="Proposals" shape=box fillcolor="#FCF3CF" URL="vscode://file/Users/williamjames/Documents/CommerceExpert/webClerk3/apps/transactions/models/proposal.py" target="_blank" tooltip="Sales proposals — forecasts weighted by probability.\nModel: apps/transactions/models/proposal.py"]
    sos [label="SOs" shape=box fillcolor="#ABEBC6"]
    pos [label="POs" shape=box fillcolor="#D6EAF8"]
    item_rec [label="Item" shape=box fillcolor="#E8DAEF"]
    qa_rec [label="QA" shape=box fillcolor="#AED6F1"]
    resource [label="Resource" shape=box fillcolor="#D5D8DC"]
    dots [label="..." shape=box fillcolor="#F2F3F4"]

    // Linkage
    linkage [label="LinkageEntry\n\nshared by lines\nrelated data\nspecs\ndata at time of action" shape=box fillcolor="#82E0AA" URL="vscode://file/Users/williamjames/Documents/CommerceExpert/webClerk3/apps/core/models/linkage.py" target="_blank" tooltip="Shared line data — specs, related records, data at time of action.\nModel: apps/core/models/linkage.py"]

    // Display modes
    displays [label="Display Modes\n\nAPI\nScrum (Kanban)\nGantt\nMap\nCalendar" shape=box fillcolor="#F5B7B1"]

    // Edges
    action -> action_ref [color="#E59866"]
    action_ref -> any_record
    any_record -> customer [style=invis]
    any_record -> vendor [style=invis]
    any_record -> proposals [style=invis]
    any_record -> sos [style=invis]
    any_record -> pos [style=invis]
    any_record -> item_rec [style=invis]
    any_record -> qa_rec [style=invis]
    any_record -> resource [style=invis]

    action -> linkage [color="#27AE60"]
    linkage -> any_record [color="#27AE60"]

    action -> displays [color="#E74C3C"]

    // ── Cross-references ──
    xref [label="See also:\n· Action Documents (p.18)\n· Action Touches (p.19)\n· Project (p.20)\n· Project Views (p.21)" shape=note fillcolor="#F4ECF7" fontsize=8]
}
