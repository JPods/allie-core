digraph alice_daily_stack {
    // Alice Daily Stack — Commerce Signals → Morning Actions → Measured Outcomes
    // Established 2026-08-28

    rankdir=LR;
    fontname="Helvetica";
    node [fontname="Helvetica", fontsize=10, style=filled];
    edge [fontname="Helvetica", fontsize=8];

    labelloc="t";
    label="Alice Daily Stack\nCommerce Signals → Morning Actions → Measured Outcomes";
    fontsize=14;

    // ── Commerce Data Signals ──
    subgraph cluster_signals {
        label="Commerce Signals";
        style=rounded;
        color="#5D4037";
        bgcolor="#FFF8E1";

        touches [label="Touches\nlast contact\nresponse time", shape=cylinder, fillcolor="#FFE0B2"];
        proposals [label="Proposals\npending, age\ndollar value", shape=cylinder, fillcolor="#FFE0B2"];
        orders [label="Orders\nreorder cadence\noverdue", shape=cylinder, fillcolor="#FFE0B2"];
        invoices [label="Invoices\npast due\nbalance", shape=cylinder, fillcolor="#FFE0B2"];
        items [label="Items\nslow movers\nmargin data", shape=cylinder, fillcolor="#FFE0B2"];
        observations [label="Observations\npatterns\nanomalies", shape=cylinder, fillcolor="#FFE0B2"];
        vendor_bundles [label="Vendor Bundles\nlead times\nprice changes", shape=cylinder, fillcolor="#FFE0B2"];
    }

    // ── Alice Three Capacities ──
    subgraph cluster_alice {
        label="Alice";
        style=rounded;
        color="#1565C0";
        bgcolor="#E3F2FD";

        alice_ops [label="Alice-ops\nvalidate data\nflag violations", shape=box, fillcolor="#FFB3B3", color="#CC0000"];
        alice_hc [label="Alice-hc\nspot patterns\nbuild stack", shape=box, fillcolor="#B3D9FF", color="#0066CC"];
        alice_lib [label="Alice-lib\nmeasure outcomes\ngrade A-F", shape=box, fillcolor="#B3FFB3", color="#006600"];
    }

    // ── Morning Stack ──
    subgraph cluster_stack {
        label="Morning Stack (Action Records)";
        style=rounded;
        color="#2E7D32";
        bgcolor="#E8F5E9";

        call [label="Call\nCustomer X\n45 days since\nlast order", shape=note, fillcolor="#C8E6C9"];
        followup [label="Follow Up\nProposal #892\n7 days, $12K", shape=note, fillcolor="#C8E6C9"];
        email_vendor [label="Email\nVendor Y\nconfirm lead time", shape=note, fillcolor="#C8E6C9"];
        text_ship [label="Text\nCustomer Z\norder shipped", shape=note, fillcolor="#C8E6C9"];
        quote [label="Quote\nCustomer W\nsearched, didn't buy", shape=note, fillcolor="#C8E6C9"];
        social [label="Post\nItem X trending\n300% turn spike", shape=note, fillcolor="#DCEDC8"];
    }

    // ── Rep Actions ──
    subgraph cluster_rep {
        label="Rep Flies the Plane";
        style=rounded;
        color="#E65100";
        bgcolor="#FFF3E0";

        rep [label="Sales Rep\nopens WC3\nsees cards", shape=box, fillcolor="#FFCC80", color="#E65100"];
        click_call [label="Click\nto Call", shape=ellipse, fillcolor="#FFE0B2"];
        click_email [label="Click\nto Email", shape=ellipse, fillcolor="#FFE0B2"];
        click_text [label="Click\nto Text", shape=ellipse, fillcolor="#FFE0B2"];
        click_quote [label="Click\nto Quote", shape=ellipse, fillcolor="#FFE0B2"];
    }

    // ── Touch Records ──
    touch_out [label="Touch\nchannel + direction\nrecorded", shape=box, fillcolor="#E1BEE7", color="#7B1FA2"];

    // ── Outcome ──
    outcome [label="Outcome\nreorder? close?\npayment?", shape=diamond, fillcolor="#FFEB3B", color="#F9A825"];

    // ── Edges: Signals → Alice ──
    touches -> alice_hc;
    proposals -> alice_hc;
    orders -> alice_hc;
    invoices -> alice_hc;
    items -> alice_hc;
    observations -> alice_hc;
    vendor_bundles -> alice_hc;

    touches -> alice_ops [style=dashed, color="#CC0000"];
    invoices -> alice_ops [style=dashed, color="#CC0000"];

    // ── Edges: Alice → Stack ──
    alice_hc -> call [label="pattern:\noverdue reorder"];
    alice_hc -> followup [label="pattern:\nstale proposal"];
    alice_hc -> email_vendor [label="pattern:\nlead time check"];
    alice_hc -> text_ship [label="signal:\nshipment"];
    alice_hc -> quote [label="signal:\nsite search"];
    alice_hc -> social [label="pattern:\ntrending item"];

    // ── Edges: Stack → Rep ──
    call -> rep;
    followup -> rep;
    email_vendor -> rep;
    text_ship -> rep;
    quote -> rep;

    // ── Edges: Rep → Act ──
    rep -> click_call;
    rep -> click_email;
    rep -> click_text;
    rep -> click_quote;

    // ── Edges: Act → Touch ──
    click_call -> touch_out;
    click_email -> touch_out;
    click_text -> touch_out;
    click_quote -> touch_out;

    // ── Edges: Touch → Outcome → Lib ──
    touch_out -> outcome;
    outcome -> alice_lib [label="did it\nwork?"];
    alice_lib -> alice_hc [label="adjust\npriority\nweights", style=dashed, color="#006600"];

    // ── Social → separate path ──
    social -> outcome [label="engagement\n→ sales?", style=dashed];
}
