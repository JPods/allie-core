// WC3 Connection: Local Server Deployment — dev to production on user-owned hardware
// Render: dot -Tpdf wc3-conn-deploy.dot -o wc3-conn-deploy.pdf

// CodeMap revision: 1 — 2026-08-11

digraph wc3_conn_deploy {
    size="7.5,10.0"
    ratio="compress"


    rankdir=TB
    fontname="Helvetica"
    fontsize=11
    node [fontname="Helvetica" fontsize=10 style=filled]
    edge [fontname="Helvetica" fontsize=8]
    label="WC3 Connection — Local Server Deployment"
    labelloc=t
    fontsize=14
    pad=0.5

    // ── Dev Mac ──
    dev [label="Dev Mac\n(MacBook Pro)\n\nCode + test\nrunserver.sh\nlocalhost:8000" shape=box fillcolor="#D4E6F1"]

    // ── rsync ──
    rsync [label="rsync\n\nDeploy to Andi\nExclude: venv, .git,\ncredentials, __pycache__" shape=octagon fillcolor="#F5CBA7"]

    // ── Andi server ──
    subgraph cluster_andi {
        label="Andi (Mac Mini / IT15)\nUser-owned hardware"
        style=filled
        fillcolor="#F8F9F9"
        color="#BDC3C7"
        fontsize=10

        nginx [label="nginx\n(80 / 443)\n\nSSL termination\nStatic files\nProxy pass" shape=box fillcolor="#FCF3CF"]
        gunicorn [label="gunicorn\n(8000)\n\n4 workers\nUnix socket\nWSGI" shape=box fillcolor="#FCF3CF"]
        django [label="Django\n(WebClerk3)\n\nwcapi endpoints\nRBAC enforcement\nBusiness logic" shape=box fillcolor="#ABEBC6"]
        postgres [label="PostgreSQL\n(5432)\n\ncommerce_expert DB\nAll production data\nLocal backups" shape=box fillcolor="#FCF3CF"]
        redis [label="Redis\n(6379)\n\nCache\nSession store\nCelery broker" shape=box fillcolor="#FCF3CF"]
    }

    // ── Cloudflare ──
    cloudflare [label="Cloudflare Tunnel\n(optional)\n\nPublic access\nDDoS protection\nSSL at edge" shape=box fillcolor="#E8DAEF"]

    // ── Public internet ──
    public [label="Public Internet\n\nwebclerk.com\n/sort /app/ /wcapi/\n/admin/" shape=box fillcolor="#D4E6F1"]

    // ── Sovereignty note ──
    boundary [label="DATA SOVEREIGNTY\n\nUser owns hardware and data.\nWC_HQ has no access.\nNo cloud dependency.\nWorks offline." shape=note fillcolor="#FADBD8"]

    // ── Stack edges ──
    dev -> rsync [label="deploy"]
    rsync -> nginx [label="files to\nAndi"]

    nginx -> gunicorn [label="proxy\npass"]
    gunicorn -> django
    django -> postgres [label="ORM" dir=both]
    django -> redis [label="cache\nsessions" dir=both]

    // ── Cloudflare path ──
    nginx -> cloudflare [label="tunnel\n(optional)"]
    cloudflare -> public [label="expose\npublic URL"]

    // ── Direct LAN access ──
    nginx -> public [style=dashed label="LAN\ndirect"]

    // ── Boundary placement ──
    postgres -> boundary [style=invis]
}
