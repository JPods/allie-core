// WC3 Calendar Sync Flow — bidirectional action-to-calendar sync
// Render: dot -Tpdf wc3-conn-calendar.dot -o wc3-conn-calendar.pdf

// CodeMap revision: 1 — 2026-08-11

digraph wc3_conn_calendar {
    size="7.5,10.0"
    ratio="compress"


    rankdir=TB
    fontname="Helvetica"
    fontsize=11
    node [fontname="Helvetica" fontsize=10 style=filled]
    edge [fontname="Helvetica" fontsize=8]
    label="WC3 — Calendar Sync Flow"
    labelloc=t
    fontsize=14
    pad=0.5

    // WC3 Action
    action [label="Action\n(Action model)\n\ndue date\nassigned_to\nproject\nstatus" shape=box fillcolor="#D4E6F1"]

    // Sync engine
    sync_out [label="Outbound Sync\n\nAction → Event\n[WC3] prefix tag\ndue date → event time" shape=octagon fillcolor="#F5CBA7"]

    // Calendar providers
    subgraph cluster_calendars {
        label="Calendar Providers"
        style=filled fillcolor="#F5EEF8" color="#D7BDE2"
        fontsize=8
        google_cal [label="Google\nCalendar" shape=box fillcolor="#E8DAEF" fontsize=8]
        outlook_cal [label="Outlook\nCalendar" shape=box fillcolor="#E8DAEF" fontsize=8]
    }

    // Calendar event
    cal_event [label="Calendar Event\n\n[WC3] title prefix\ndescription\ntime\nattendees" shape=box fillcolor="#FCF3CF"]

    // Inbound sync
    sync_in [label="Inbound Sync\n\nEvent → Action\ndate/time changes\nstatus changes" shape=octagon fillcolor="#F5CBA7"]

    // Conflict decision
    conflict [label="Conflict?" shape=diamond fillcolor="#FADBD8"]

    // Resolution
    wc3_wins [label="WC3 Wins\n\nAction is\nsource of truth\noverwrite calendar" shape=box fillcolor="#ABEBC6"]

    // No conflict
    merge [label="Merge\nChanges\n\nupdate Action\nfields" shape=octagon fillcolor="#F5CBA7"]

    // Overdue check
    overdue [label="Overdue?" shape=diamond fillcolor="#FADBD8"]

    // Escalation
    escalate [label="Escalation\n\nnotify owner\nnotify project lead" shape=box fillcolor="#FCF3CF"]

    // Alice
    alice [label="Alice\nOverdue Monitoring\n\naging actions\nmissed deadlines\nworkload balance" shape=box fillcolor="#AED6F1"]

    // Edges — outbound sync
    action -> sync_out [label="on save\n(has due date)"]
    sync_out -> google_cal
    sync_out -> outlook_cal
    google_cal -> cal_event
    outlook_cal -> cal_event

    // Edges — inbound sync
    cal_event -> sync_in [label="webhook /\npolling"]
    sync_in -> conflict

    // Conflict resolution
    conflict -> wc3_wins [label="yes"]
    conflict -> merge [label="no"]
    wc3_wins -> action [label="overwrite\ncalendar" style=dashed]
    merge -> action [label="update\naction"]

    // Overdue monitoring
    action -> overdue [label="check\ndue date"]
    overdue -> escalate [label="yes\npast due"]
    overdue -> alice [label="no\non track" style=dashed]
    escalate -> alice [label="flag\npattern" style=dashed]
}
